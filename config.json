    "reid_area_weight": 0.3,
    "reid_min_consecutive_matches": 2,
    "reid_stable_confidence_threshold": 0.75,
    "reid_cooldown_period": 60,
    "tts_endpoints": {
      "welcome": "https://robot-api2.pvi.digital/api/v1/conversation/tts-hello",
