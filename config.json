{
    "model_path": "yolov8n.pt",
    "confidence_threshold": 0.5,
    "iou_threshold": 0.45,
    "input_source": 0,
    "output_dir": "output",
    "log_dir": "logs",
    "save_images": true,
    "save_video": false,
    "video_fps": 30,
    "detection_interval": 1,
    "welcome_threshold": 20,
    "departure_threshold": 30,
